# SG CRM environment. Copy to .env in the repo root and edit.
# Everything here is machine-level config; anything an admin should be able to
# change without a restart lives in Settings (the `settings` table) instead.

# --- Server ---
# production: serves client/dist, logs to data/logs/app.log, refuses to boot
# without a real SESSION_SECRET.
NODE_ENV=development
PORT=3000

# Session cookie signing secret. REQUIRED in production — the server exits with
# an explanation if it is missing. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Send the session cookie only over HTTPS. Leave false for the normal LAN
# deployment (plain http://server:3000) — true would make login impossible
# without a TLS reverse proxy in front.
SESSION_COOKIE_SECURE=false

# --- Admin login ---
# Used ONLY on first boot to create the single admin user.
# Change the password afterwards in Settings → Security.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Paths ---
# Relative paths are resolved from the repo root.
DATA_DIR=data
DB_PATH=data/crm.db
BACKUP_DIR=data/backups

# --- Logging ---
# level: trace|debug|info|warn|error|fatal|silent (default: info in production,
# debug elsewhere).
LOG_LEVEL=
# In production the logger writes stdout AND data/logs/app.log. Set LOG_FILE to
# use a different path, LOG_TO_FILE=false to disable the file entirely, or
# LOG_TO_FILE=true to get one in development too.
LOG_FILE=
LOG_TO_FILE=
# Size-based rotation of app.log, done in-process: roll at LOG_MAX_SIZE_MB and
# keep app.log.1 .. app.log.<LOG_KEEP>. (NSSM rotates service-out/err.log.)
LOG_MAX_SIZE_MB=10
LOG_KEEP=5
LOG_ROTATE_CHECK_MS=60000

# --- Zoho Books (phase 1) ---
# Self Client credentials from https://api-console.zoho.in
# The refresh token + organization id are stored in the settings table via the UI.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# --- SMTP / email digests (phase 4) ---
# Fallbacks only: whatever is set in Settings -> Reminders wins over these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dev/test escape hatch: 'json' or 'stream' captures mail with nodemailer's fake
# transports instead of delivering it. Leave EMPTY in production.
SMTP_TRANSPORT=

# --- Scheduled jobs (phase 4) ---
# node-cron runs in the server process: the daily digest at `digest_send_time`
# (Mon-Sat) and the Zoho incremental sync every 30 min, 08:00-20:00 Mon-Sat.
# Set to false to bring the server up with no schedulers at all.
ENABLE_CRON=true

# --- Dev only ---
# Guard on server/scripts/seed-fake.js. Never set this on the production box.
ALLOW_FAKE_SEED=
