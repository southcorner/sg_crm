# --- Server ---
NODE_ENV=development
PORT=3000

# Session cookie signing secret. CHANGE THIS in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin login ---
# Used ONLY on first boot to create the single admin user.
# Change the password from the Settings page afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Database ---
# Relative paths are resolved from the repo root. Default: data/crm.db
DB_PATH=data/crm.db

# --- Zoho Books (phase 1) ---
# Self Client credentials from https://api-console.zoho.in
# The refresh token + organization id are stored in the settings table via the UI.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# --- SMTP / email digests (phase 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
